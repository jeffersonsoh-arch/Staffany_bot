# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Settings -> Account & Security -> Workspace API Keys in app.staffany.com
STAFFANY_API_KEY=

# Usually no need to change
STAFFANY_API_BASE_URL=https://api.staffany.com

# IANA timezone your rosters are scheduled in, used for "today"/date lookups
STAFFANY_TIMEZONE=Asia/Singapore
